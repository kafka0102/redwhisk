{
  "name": "redwhisk",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "format": "prettier --write .vscode/extensions.json index.html package.json pnpm-lock.yaml prettier.config.mjs eslint.config.js vite.config.ts vitest.config.ts tsconfig.json tsconfig.node.json \"src/**/*.{ts,tsx,css}\" src-tauri/tauri.conf.json \"src-tauri/capabilities/**/*.json\"",
    "lint": "eslint src eslint.config.js vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:parity": "vitest run src/shared/commands/__parity__",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "ui:add": "shadcn add",
    "build:macos": "bash scripts/build-macos.sh",
    "bump-version": "node scripts/bump-version.mjs",
    "release:version": "bash scripts/release-version.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "next-themes": "^0.4.6",
    "quill": "^2.0.3",
    "react": "^19.1.0",
    "react-arborist": "^3.10.5",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.32.1"
}
