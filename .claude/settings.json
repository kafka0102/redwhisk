{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/yujianjia/workspace/kafka/redwhisk/.claude/auto-commit.js",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/yujianjia/workspace/kafka/redwhisk/.claude/auto-commit.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
